# Copy to .env (the launcher does this automatically) and edit as needed.
# Never commit .env. Never paste these values into chat.

# --- Server ---------------------------------------------------------------
CLIPENGINE_PORT=8765
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from your phone on the same
# private network (a DASHBOARD_PASSWORD is then REQUIRED and the launcher refuses
# to start without one). Windows Firewall will ask you to allow access once.
# Preferred for phones: keep 127.0.0.1 and use "tailscale serve --bg 8765" (README §9).
CLIPENGINE_HOST=127.0.0.1
DASHBOARD_PASSWORD=
OPEN_BROWSER=1
# CLIPENGINE_DATA_DIR=D:\ClippingEngineData
# Optional credential namespace. Set a unique lowercase ID for each new
# workspace and configure a separate data directory, settings file and port.
# Existing tokens are never copied. Leave unset for legacy installations.
# CLIPENGINE_WORKSPACE_ID=example-workspace

# --- Transcription (faster-whisper, fully local) ----------------------------
# auto picks a model from your CPU/GPU/RAM. Options: tiny, base, small, medium,
# large-v3 (append .en for English-only tiny/base/small/medium).
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# Leave empty to auto-detect; set e.g. en to force English (faster, more accurate).
TRANSCRIBE_LANGUAGE=
VAD_FILTER=1
# 0 = automatic (physical-core estimate). Beam 5 = best accuracy; 1–2 is faster.
WHISPER_CPU_THREADS=0
WHISPER_BEAM_SIZE=5
# Long recordings are transcribed in checkpointed chunks of this many seconds, so a crash
# or restart resumes where it stopped.
TRANSCRIBE_CHUNK_SECONDS=1200
# NVIDIA GPU on Windows: set to 1 so the launcher installs the CUDA 12 cuBLAS/cuDNN
# runtime wheels (~1 GB). Without them the GPU is skipped and the CPU is used.
INSTALL_CUDA_LIBS=0

# --- Excerpt selection --------------------------------------------------------
# Up to this many clips; fewer if fewer passages genuinely qualify (never padded).
CLIPS_PER_RECORDING=6
# Content-led selection: clip length follows the speaker's natural boundaries.
# These are only safety limits, not a target. (v1/v2 legacy profiles used a 55 s target.)
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=150
# v4 (default) = content-led + context boundaries: a clip never starts mid-sentence, on an answer
# without its question, on "also/and/finally…", or across a change of speaker, and never ends on
# a hand-over. v3 = the previous default (kept for comparison).
SELECTION_PROFILE=v6
CONTEXT_SECONDS=25
# auto = use a local Ollama model for re-ranking if one is running, else deterministic.
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Rendering ------------------------------------------------------------------
VIDEO_CRF=21
X264_PRESET=veryfast
# Captions use the approved Anton style by default (bundled font). Adjust size, outline,
# position, on/off and the optional backing in Settings → Captions.

# --- Ingestion ---------------------------------------------------------------------
# Direct video-file links (…/file.mp4) from public websites are downloaded automatically.
# Web *pages* are only fetched (with yt-dlp) for domains listed here — list a site only if
# its terms AND the rights holder permit automated downloading. Example:
#   ALLOWED_URL_DOMAINS=archive.org,commons.wikimedia.org
# Rumble, YouTube, TikTok, Instagram, Facebook, X, Twitch… forbid automated access without
# their written permission: their links become "pending sources" (you attach the file),
# unless you record the platform's written permission in Settings → Source permissions.
ALLOWED_URL_DOMAINS=
MAX_UPLOAD_MB=8192
# Some sites (e.g. Wikimedia) ask automated clients for an informative User-Agent with contact
# details; set one here if a direct download is refused with HTTP 403.
# HTTP_USER_AGENT=LocalClippingEngine/1.1 (contact: you@example.org)
# Watch folder: videos saved here are imported automatically (default: data\inbox).
# INBOX_DIR=C:\Users\You\Videos\ClipInbox

# --- Automatic source monitoring (Sources page) ------------------------------------
# Sources are only enabled when their site is in ALLOWED_URL_DOMAINS or a written permission is
# recorded. Restricted platforms (Rumble, YouTube, ...) stay disabled without the platform's permission.
MONITOR_ENABLED=1
MAX_RECORDING_HOURS=8
MIN_RECORDING_SECONDS=60
LIVE_RESTART_LIMIT=120

# --- Running unattended -------------------------------------------------------------
# Keep Windows awake: off | active (while recording or processing; default) | monitoring
# (whenever an enabled source is being watched). A per-process request made while the engine
# runs; no Windows power setting is changed. Also settable in Settings → Running unattended.
PREVENT_SLEEP=active

# --- Email notifications (Settings → Notifications) -----------------------------
# These (and DASHBOARD_PASSWORD / DASHBOARD_URL above) can be set from the dashboard or the setup
# assistant, which write them here for you. A mail password entered in the dashboard is kept in
# Windows Credential Manager, not in this file.
# NOTHING is sent until you approve the recipient and wording in Settings → Notifications.
NOTIFY_ENABLED=1
# Your notification address (kept only in your local .env):
NOTIFY_TO=
# graph = Microsoft Graph (Outlook.com/Hotmail, recommended) | smtp
NOTIFY_TRANSPORT=graph
NOTIFY_ON_FAILURE=1
# Link base used inside emails, e.g. your Tailscale address https://<pc>.<tailnet>.ts.net
DASHBOARD_URL=
# Application (client) ID from your free Microsoft Entra app registration (README §8). Not a secret.
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=consumers
# SMTP fallback (only if NOTIFY_TRANSPORT=smtp). The password stays in this local file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0

# --- Jobs & retention ----------------------------------------------------------
JOB_MAX_ATTEMPTS=3
DELETE_REJECTED_RENDERS_AFTER_DAYS=14
# 0 = NEVER delete original recordings automatically (default).
DELETE_ORIGINALS_AFTER_DAYS=0
STORAGE_WARNING_GB=50

# --- Publishing (optional; see README sections 6 and 7) ----------------------------
# TikTok Content Posting API (upload to inbox, scopes user.info.basic,video.upload)
# TIKTOK_APP_TYPE=desktop uses PKCE (TikTok desktop variant) with a 127.0.0.1 redirect.
# TIKTOK_APP_TYPE=web needs an https redirect URI you control (e.g. your Tailscale address).
TIKTOK_APP_TYPE=desktop
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/oauth/tiktok/callback

# Instagram Reels. INSTAGRAM_AUTH_MODE:
#   facebook  (default) Facebook Login for Business: account must be linked to a Facebook
#             Page; the clip file is uploaded directly (dashboard stays private).
#   instagram Instagram Login: no Facebook Page, but Meta must download each clip from a
#             public https link -> requires PUBLIC_MEDIA_BASE_URL (e.g. Tailscale Funnel).
INSTAGRAM_AUTH_MODE=facebook
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8765/oauth/instagram/callback
# Optional exact allowlisted HTTPS callback dedicated to read-only Meta analytics.
META_ANALYTICS_REDIRECT_URI=
META_GRAPH_VERSION=v23.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
PUBLIC_MEDIA_BASE_URL=

# ---- Multi-niche expansion (session 6) -----------------------------------------------------
# Source-platform discovery (free developer registrations; metadata only, never retrieval rights)
# Fill these in on THIS computer only (never paste them into chat, email or Git). Leave blank until you have them:
# the engine starts cleanly without them and the Portfolio page shows NEEDS_CREDENTIALS for that platform.
# After saving: restart, then run Check-Portfolio.cmd (verifies identities through the official APIs).
#   YouTube : Google Cloud console > APIs & Services > enable "YouTube Data API v3" > Credentials > API key (one key)
#   Twitch  : dev.twitch.tv/console > Register Your Application > Client ID + New Secret (Category: Other)
#   Kick    : Kick developer settings > create an app > Client ID + Client Secret
# Each needs BOTH parts where two are listed; a half-set is reported as PARTIAL, not as working.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Google Drive storage + private YouTube uploads: your own OAuth client of type "Desktop app".
# Prefixed on purpose so an unrelated machine-wide GOOGLE_CLIENT_ID is never used.
CLIPENGINE_GOOGLE_CLIENT_ID=
CLIPENGINE_GOOGLE_CLIENT_SECRET=
CLOUD_PROVIDER=gdrive
CLOUD_MIN_FREE_GB=2
# Lifecycle: delete ENGINE-ACQUIRED raw recordings once every safety gate passes (incl. verified Drive copy)
RAW_DELETE_AFTER_CLOUD=1
REJECTED_CLIP_HOURS=24
PUBLISHED_CLIP_DAYS=7
# Retention never deletes the Google Drive copy of an approved/published clip (the recoverable master). Leave on.
KEEP_DRIVE_MASTER=1
# Finished-clip local cleanup (Storage page; OFF until you switch it on there): hours to wait after the last
# required destination is confirmed before the local MP4 is removed.
LOCAL_CLEANUP_GRACE_HOURS=24
# Queue and disk planning
DEFER_HEAVY_WHILE_RECORDING=1
DISK_RESERVE_GB=1
RECORD_GB_PER_HOUR=1.5
# Set to 0 to hold automatically discovered VOD downloads while allowing live recording.
AUTO_DISCOVERED_DOWNLOADS=1
